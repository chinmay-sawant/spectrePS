%!PS-Adobe-3.0
% Repo-authored validation corpus program.
% Five filled squares at gray 0, 0.25, 0.5, 0.75, and 1.
0 setgray
newpath 50 50 moveto 100 0 rlineto 0 100 rlineto -100 0 rlineto closepath fill
0.25 setgray
newpath 175 50 moveto 100 0 rlineto 0 100 rlineto -100 0 rlineto closepath fill
0.5 setgray
newpath 300 50 moveto 100 0 rlineto 0 100 rlineto -100 0 rlineto closepath fill
0.75 setgray
newpath 425 50 moveto 100 0 rlineto 0 100 rlineto -100 0 rlineto closepath fill
1 setgray
newpath 550 50 moveto 100 0 rlineto 0 100 rlineto -100 0 rlineto closepath fill
showpage
