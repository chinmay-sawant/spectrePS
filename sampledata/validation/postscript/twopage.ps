%!PS-Adobe-3.0
% Repo-authored validation corpus program.
% Two pages with one stroked rectangle and one filled rectangle.
0 setgray
newpath
50 50 moveto 200 0 rlineto 0 200 rlineto -200 0 rlineto closepath
stroke
showpage
0.5 setgray
newpath
300 300 moveto 100 0 rlineto 0 100 rlineto -100 0 rlineto closepath
fill
showpage
